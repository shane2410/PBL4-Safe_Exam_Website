# Application Settings
PROJECT_NAME="Secure Online Exam System"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Settings (XAMPP MySQL / MariaDB)
DATABASE_URL="mysql+pymysql://root:@127.0.0.1:3306/secure_exam_db?charset=utf8mb4"

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Real-time / Anticheat Settings
DEFAULT_MAX_VIOLATION_ALLOWED=5
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
