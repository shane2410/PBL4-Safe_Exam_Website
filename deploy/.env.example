# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG TRIỂN KHAI DOCKER (DEPLOYMENT ENVIRONMENT TEMPLATE)
# Sao chép file này thành .env trong thư mục deploy/ trước khi khởi chạy:
#   cp deploy/.env.example deploy/.env
# ==============================================================================

# --- 1. Cấu hình Cơ sở dữ liệu MySQL ---
MYSQL_ROOT_PASSWORD=Thay_Bang_Mat_Khau_Database_Phuc_Tap_2026!
MYSQL_DATABASE=secure_exam_db
MYSQL_BIND_IP=127.0.0.1
MYSQL_PORT=3306

# --- 2. Cấu hình Ứng dụng Backend FastAPI ---
# Môi trường: "production" hoặc "development"
# Khi ENV=production: app sẽ từ chối khởi động nếu SECRET_KEY mặc định hoặc ngắn < 32 ký tự
ENV=production
DEBUG=false

# KHÓA BÍ MẬT BẮT BUỘC ĐỔI (Tối thiểu 32 - 64 ký tự ngẫu nhiên)
# Bạn có thể sinh khóa bằng lệnh: openssl rand -hex 32
SECRET_KEY=thay_the_bang_chuoi_ngau_nhien_64_ky_tu_hex_truoc_khi_trien_khai_that

# Thời gian sống của JWT access token (phút)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Danh sách Origin được phép truy cập CORS (JSON Array).
# BẮT BUỘC khớp chính xác với domain hoặc IP truy cập của người dùng và SEB Client!
# Ví dụ: '["http://exam.truong.edu.vn", "https://exam.truong.edu.vn", "http://192.168.1.100"]'
CORS_ORIGINS='["http://localhost", "https://localhost", "http://127.0.0.1"]'

# Tự động nạp dữ liệu mẫu ban đầu (admin, teacher1, student1, ca thi mẫu)
# Đặt true trong lần đầu triển khai, sau đó có thể chuyển về false
AUTO_SEED=true

# Cấu hình chống gian lận & giám sát
DEFAULT_MAX_VIOLATION_ALLOWED=5
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
CLIENT_NONCE_TTL_SECONDS=30

# --- 3. Cấu hình Cổng Mạng Reverse Proxy (Nginx) ---
PORT_HTTP=80
PORT_HTTPS=443
