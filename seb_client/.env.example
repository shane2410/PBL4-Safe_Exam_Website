# Sao chép file này thành .env rồi chỉnh cho máy của bạn.
# KHÔNG commit file .env thật.

# Backend FastAPI
SEB_BACKEND_URL=http://127.0.0.1:8000

# URL trang thi — thay đổi ở đây để trỏ sang máy khác (VD: bản deploy thật
# cho giảng viên, hoặc IP của máy chủ trong phòng thi). Bắt buộc có {room_code}.
# `embedded=1` bảo web app NHƯỜNG socket cho SEB Client — nếu thiếu, cả hai
# cùng mở socket cho một phiên và server sẽ ghi DUPLICATE_LOGIN rồi buộc nộp bài.
SEB_EXAM_URL_TEMPLATE=http://localhost:5173/exam/room?room={room_code}&embedded=1

# Trang thi mà QWebEngineView được phép nạp.
# navigation_guard chặn MỌI origin ngoài danh sách này.
SEB_EXAM_ORIGIN=http://localhost:5173
SEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000

# DEBUG | INFO | WARNING | ERROR
SEB_LOG_LEVEL=INFO

# Nhịp heartbeat (giây). Server timeout sau 30s, không đặt cao quá 20.
SEB_HEARTBEAT_INTERVAL=10

# true để chạy CI không cần màn hình. KHÔNG bật khi thi thật.
SEB_HEADLESS=false